generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id             String       @id
  itineraryDayId String
  name           String
  description    String?
  location       String?
  startTime      DateTime?
  endTime        DateTime?
  category       String?
  createdAt      DateTime     @default(now())
  ItineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
}

model ItineraryDay {
  id          String     @id
  tripId      String
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime   @default(now())
  Activity    Activity[]
  Trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id
  userId      String
  tripId      String?
  title       String
  description String?
  photos      String[]
  location    String?
  createdAt   DateTime @default(now())
  Trip        Trip?    @relation(fields: [tripId], references: [id])
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id                                 String @id
  referrerId                         String
  referredUserId                     String @unique
  status                             String
  reward                             Float  @default(0.0)
  User_Referral_referredUserIdToUser User   @relation("Referral_referredUserIdToUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  User_Referral_referrerIdToUser     User   @relation("Referral_referrerIdToUser", fields: [referrerId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id          String   @id
  userId      String
  type        String
  referenceId String
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPhoto {
  id        String   @id
  tripId    String
  userId    String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPreference {
  id                      String   @id
  userId                  String   @unique
  travelStyle             String?
  budgetRange             String?
  interests               String[]
  foodPreference          String[]
  accommodationPreference String?
  tripDuration            String?
  User                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id           String         @id
  userId       String
  destination  String
  title        String
  startDate    DateTime
  endDate      DateTime
  budget       Float
  travelers    Int
  status       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ItineraryDay ItineraryDay[]
  Memory       Memory[]
  TravelPhoto  TravelPhoto[]
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  PlaceVisitStatus PlaceVisitStatus[]
}

model User {
  id                                     String              @id
  clerkUserId                            String              @unique
  email                                  String
  firstName                              String?
  lastName                               String?
  profileImage                           String?
  createdAt                              DateTime            @default(now())
  updatedAt                              DateTime
  Memory                                 Memory[]
  Referral_Referral_referredUserIdToUser Referral?           @relation("Referral_referredUserIdToUser")
  Referral_Referral_referrerIdToUser     Referral[]          @relation("Referral_referrerIdToUser")
  SavedItem                              SavedItem[]
  TravelPhoto                            TravelPhoto[]
  TravelPreference                       TravelPreference?
  Trip                                   Trip[]
  UserProfile                            UserProfile?
  Wallet                                 Wallet?
  WalletTransaction                      WalletTransaction[]
  UserLocation                           UserLocation[]
  MapPreference                          MapPreference?
  UserPreference                         UserPreference?
  FavoriteHotel                          FavoriteHotel[]
  FavoriteActivity                       FavoriteActivity[]
  Feedback                               Feedback[]
  Notification                           Notification[]
  UserSearchHistory                      UserSearchHistory[]
}

model UserProfile {
  id          String    @id
  userId      String    @unique
  clerkUserId String    @unique
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  country     String?
  city        String?
  language    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id      String @id
  userId  String @unique
  balance Float  @default(0.0)
  User    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id
  userId    String
  amount    Float
  type      String
  reason    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLocation {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaceVisitStatus {
  id        String   @id @default(uuid())
  tripId    String
  placeId   String
  status    String   // "completed" | "current" | "upcoming"
  updatedAt DateTime @updatedAt
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, placeId])
}

model MapPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  layers        String[]
  transportMode String   @default("walk")
  travelStyle   String   @default("adventure")
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransportRoutes {
  id             String   @id @default(uuid())
  origin         String
  destination    String
  mode           String
  serviceNumber  String?
  operator       String
  duration       String
  price          Float
  runsOn         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TransportProviders {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Stations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model BusStops {
  id        String   @id @default(uuid())
  name      String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model RailwayStations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model JourneyPlans {
  id                   String   @id @default(uuid())
  origin               String
  destination          String
  date                 String
  totalDurationMinutes Int
  totalCost            Float
  transfers            Int
  isDirect             Boolean
  bookingUrl           String
  aiExplanation        String?
  createdAt            DateTime @default(now())
}

model UserSearchHistory {
  id             String   @id @default(uuid())
  userId         String
  origin         String
  destination    String
  searchDate     String
  passengers     Int      @default(1)
  rankPreference String   @default("balanced")
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── TRAVELPORT FLIGHT BOOKING DOMAIN MODELS ─────────────────────────────────

enum BookingStatus {
  SEARCHED
  PRICED
  WORKBENCH_CREATED
  OFFER_ADDED
  TRAVELERS_ADDED
  BOOKED
  RESERVATION_CREATED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  TICKET_ISSUED
  TRAVEL_COMPLETED
  VOIDED
  REFUNDED
  EXCHANGED
  CANCELLED
  FAILED
  EXPIRED
}

enum ProviderType {
  TRAVELPORT_GDS
  TRAVELPORT_NDC
}

enum PassengerType {
  ADT
  CNN
  INF
  YTH
}

model SearchSession {
  id              String        @id @default(uuid())
  userId          String?
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  travelers       Json
  cabinClass      String
  offersCount     Int           @default(0)
  travelportTrace String?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  FlightOffers    FlightOffer[]
}

model FlightOffer {
  id              String        @id @default(uuid())
  searchSessionId String
  provider        ProviderType
  offerRef        String        // Travelport Offer Object ID
  totalPrice      Decimal       @db.Decimal(12, 2)
  basePrice       Decimal       @db.Decimal(12, 2)
  taxPrice        Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  isRefundable    Boolean       @default(false)
  validUntil      DateTime
  offerPayload    Json          // Raw Travelport JSON representation
  createdAt       DateTime      @default(now())
  SearchSession   SearchSession @relation(fields: [searchSessionId], references: [id], onDelete: Cascade)
  Reservation     Reservation[]
}

model Reservation {
  id                 String           @id @default(uuid())
  bookingReferenceId String           @unique
  userId             String
  offerId            String
  pnrLocator         String           // Travelport 6-character PNR Locator
  workbenchId        String?
  provider           ProviderType
  status             BookingStatus    @default(WORKBENCH_CREATED)
  totalAmount        Decimal          @db.Decimal(12, 2)
  currency           String           @default("INR")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  FlightOffer        FlightOffer      @relation(fields: [offerId], references: [id])
  Travelers          Traveler[]
  Tickets            Ticket[]
  Seats              SeatAssignment[]
  Ancillaries        AncillaryItem[]
  Payments           FlightPayment[]
  Exchanges          FlightExchange[]
  Refunds            FlightRefund[]
  Voids              FlightVoid[]
  AuditLogs          FlightAuditLog[]
  Commissions        FlightCommission[]
  ScheduleChanges    ScheduleChange[]
}

model Traveler {
  id            String           @id @default(uuid())
  reservationId String
  travelerRef   String           // Travelport Traveler Identifier
  type          PassengerType
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        String
  passportNo    String?
  passportExp   DateTime?
  nationality   String?
  ssrs          Json?            // Special Service Requests
  Reservation   Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  Seats         SeatAssignment[]
  Ancillaries   AncillaryItem[]
}

model Ticket {
  id            String      @id @default(uuid())
  reservationId String
  ticketNumber  String      @unique // 13-digit e-Ticket Number
  travelerRef   String
  status        String      @default("ISSUED")
  issuedAt      DateTime    @default(now())
  ticketPayload Json
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model SeatAssignment {
  id            String      @id @default(uuid())
  reservationId String
  travelerId    String
  segmentRef    String
  seatNumber    String
  price         Decimal     @db.Decimal(10, 2)
  emdNumber     String?     // Electronic Miscellaneous Document ID
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  Traveler      Traveler    @relation(fields: [travelerId], references: [id])
}

model AncillaryItem {
  id            String      @id @default(uuid())
  reservationId String
  travelerId    String
  category      String      // BAGGAGE, MEAL, LOUNGE, WIFI
  code          String
  name          String
  price         Decimal     @db.Decimal(10, 2)
  emdNumber     String?
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  Traveler      Traveler    @relation(fields: [travelerId], references: [id])
}

model FlightPayment {
  id            String      @id @default(uuid())
  reservationId String
  transactionId String      @unique
  paymentMethod String      // CARD, UPI, WALLET
  amount        Decimal     @db.Decimal(12, 2)
  status        String
  cardLastFour  String?
  authCode      String?
  createdAt     DateTime    @default(now())
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model FlightExchange {
  id             String      @id @default(uuid())
  reservationId  String
  oldTicketNo    String
  newTicketNo    String?
  penaltyAmount  Decimal     @db.Decimal(10, 2)
  fareDifference Decimal     @db.Decimal(10, 2)
  status         String
  createdAt      DateTime    @default(now())
  Reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model FlightRefund {
  id            String      @id @default(uuid())
  reservationId String
  ticketNumber  String
  refundAmount  Decimal     @db.Decimal(12, 2)
  penaltyAmount Decimal     @db.Decimal(10, 2)
  status        String
  createdAt     DateTime    @default(now())
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model FlightVoid {
  id            String      @id @default(uuid())
  reservationId String
  ticketNumber  String
  voidedAt      DateTime    @default(now())
  status        String
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model FlightAuditLog {
  id            String      @id @default(uuid())
  reservationId String
  action        String
  previousState String?
  newState      String
  details       Json?
  timestamp     DateTime    @default(now())
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model FlightCommission {
  id            String      @id @default(uuid())
  reservationId String
  agencyAmount  Decimal     @db.Decimal(10, 2)
  airlineAmount Decimal     @db.Decimal(10, 2)
  bonusAmount   Decimal     @db.Decimal(10, 2)
  currency      String      @default("INR")
  createdAt     DateTime    @default(now())
  Reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model ScheduleChange {
  id              String      @id @default(uuid())
  reservationId   String
  previousPayload Json
  newPayload      Json
  status          String      @default("PENDING_ACCEPTANCE")
  notifiedAt      DateTime    @default(now())
  actionedAt      DateTime?
  Reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ─── CONTEXT INTELLIGENCE LAYER MODELS ─────────────────────────────────────────
// Phase 1 of the Contextual Intelligence Layer plan:
// persistent memory (preferences, favorites, feedback, notifications, recommendation log).
// Consumed by backend/src/context/memory.service.ts and recommendation.service.ts.

enum FeedbackAction {
  SAVED
  SKIPPED
  RATED
  BOOKED
  CANCELLED
  CLICKED
  IGNORED
}

enum NotificationKind {
  DELAY
  GATE_CHANGE
  WEATHER
  PRICE_DROP
  VISA
  PASSPORT
  COUNTDOWN
  BUDGET
  TRAFFIC
  GENERIC
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  currency             String?  @default("INR")
  language             String?  @default("en")
  homeCity             String?
  favoriteAirlines     String[]
  favoriteHotelChains  String[]
  favoriteCuisines     String[]
  dietaryRestrictions  String[]
  accessibilityNotes   String?
  preferredTransport   String?
  updatedAt            DateTime @updatedAt
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FavoriteHotel {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  hotelName String
  city      String?
  rating    Float?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([userId])
}

model FavoriteActivity {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  name       String
  city       String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  tripId    String?
  module    String         // "flights" | "hotels" | "trains" | "buses" | "budget" | ...
  targetId  String         // flightId, hotelId, recommendation id, ...
  action    FeedbackAction
  rating    Int?           // 1-5
  metadata  Json?
  createdAt DateTime       @default(now())
  User      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@index([module, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  tripId    String?
  metadata  Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  User      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model RecommendationLog {
  id           String   @id @default(uuid())
  userId       String?
  module       String   // "budget" | "flights" | "hotels" | "trains" | ...
  inputHash    String   // md5 of normalized input — for dedup & analytics
  outputJson   Json
  aiConfidence Int      // 0-100
  accepted     Boolean? // null until user acts
  createdAt    DateTime @default(now())

  @@index([userId, module, createdAt])
  @@index([inputHash])
}


