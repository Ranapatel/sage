generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id             String       @id
  itineraryDayId String
  name           String
  description    String?
  location       String?
  startTime      DateTime?
  endTime        DateTime?
  category       String?
  createdAt      DateTime     @default(now())
  ItineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
}

model ItineraryDay {
  id          String     @id
  tripId      String
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime   @default(now())
  Activity    Activity[]
  Trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id
  userId      String
  tripId      String?
  title       String
  description String?
  photos      String[]
  location    String?
  createdAt   DateTime @default(now())
  Trip        Trip?    @relation(fields: [tripId], references: [id])
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id                                 String @id
  referrerId                         String
  referredUserId                     String @unique
  status                             String
  reward                             Float  @default(0.0)
  User_Referral_referredUserIdToUser User   @relation("Referral_referredUserIdToUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  User_Referral_referrerIdToUser     User   @relation("Referral_referrerIdToUser", fields: [referrerId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id          String   @id
  userId      String
  type        String
  referenceId String
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPhoto {
  id        String   @id
  tripId    String
  userId    String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPreference {
  id                      String   @id
  userId                  String   @unique
  travelStyle             String?
  budgetRange             String?
  interests               String[]
  foodPreference          String[]
  accommodationPreference String?
  tripDuration            String?
  User                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id           String         @id
  userId       String
  destination  String
  title        String
  startDate    DateTime
  endDate      DateTime
  budget       Float
  travelers    Int
  status       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ItineraryDay ItineraryDay[]
  Memory       Memory[]
  TravelPhoto  TravelPhoto[]
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  PlaceVisitStatus PlaceVisitStatus[]
}

model User {
  id                                     String              @id
  clerkUserId                            String              @unique
  email                                  String
  firstName                              String?
  lastName                               String?
  profileImage                           String?
  createdAt                              DateTime            @default(now())
  updatedAt                              DateTime
  Memory                                 Memory[]
  Referral_Referral_referredUserIdToUser Referral?           @relation("Referral_referredUserIdToUser")
  Referral_Referral_referrerIdToUser     Referral[]          @relation("Referral_referrerIdToUser")
  SavedItem                              SavedItem[]
  TravelPhoto                            TravelPhoto[]
  TravelPreference                       TravelPreference?
  Trip                                   Trip[]
  UserProfile                            UserProfile?
  Wallet                                 Wallet?
  WalletTransaction                      WalletTransaction[]
  UserLocation                           UserLocation[]
  MapPreference                          MapPreference?
}

model UserProfile {
  id          String    @id
  userId      String    @unique
  clerkUserId String    @unique
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  country     String?
  city        String?
  language    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id      String @id
  userId  String @unique
  balance Float  @default(0.0)
  User    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id
  userId    String
  amount    Float
  type      String
  reason    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLocation {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaceVisitStatus {
  id        String   @id @default(uuid())
  tripId    String
  placeId   String
  status    String   // "completed" | "current" | "upcoming"
  updatedAt DateTime @updatedAt
  Trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, placeId])
}

model MapPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  layers        String[]
  transportMode String   @default("walk")
  travelStyle   String   @default("adventure")
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransportRoutes {
  id             String   @id @default(uuid())
  origin         String
  destination    String
  mode           String
  serviceNumber  String?
  operator       String
  duration       String
  price          Float
  runsOn         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TransportProviders {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Stations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model BusStops {
  id        String   @id @default(uuid())
  name      String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model RailwayStations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model JourneyPlans {
  id                   String   @id @default(uuid())
  origin               String
  destination          String
  date                 String
  totalDurationMinutes Int
  totalCost            Float
  transfers            Int
  isDirect             Boolean
  bookingUrl           String
  aiExplanation        String?
  createdAt            DateTime @default(now())
}

model UserSearchHistory {
  id             String   @id @default(uuid())
  userId         String?
  origin         String
  destination    String
  searchDate     String
  passengers     Int      @default(1)
  rankPreference String   @default("balanced")
  createdAt      DateTime @default(now())
}
