generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  clerkUserId        String              @unique
  email              String
  firstName          String?
  lastName           String?
  profileImage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memories           Memory[]
  referralReceived   Referral?           @relation("ReferredUser")
  referralsSent      Referral[]          @relation("Referrer")
  savedItems         SavedItem[]
  travelPhotos       TravelPhoto[]
  travelPreference   TravelPreference?
  trips              Trip[]
  profile            UserProfile?
  wallet             Wallet?
  priceWatches       PriceWatch[]
  walletTransactions WalletTransaction[]
  userLocations      UserLocation[]
  mapPreference      MapPreference?
  userPreference     UserPreference?
  favoriteHotels     FavoriteHotel[]
  favoriteActivities FavoriteActivity[]
  feedback           Feedback[]
  notifications      Notification[]
  searchHistory      UserSearchHistory[]
}

model Trip {
  id            String         @id @default(uuid())
  userId        String
  destination   String
  title         String
  startDate     DateTime
  endDate       DateTime
  budget        Float
  travelers     Int
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  optimizedAt   DateTime?      // Last time route optimization ran
  optimizationHash String?     // Hash of place coords at last optimization (prevents duplicate calls)
  itineraryDays ItineraryDay[]
  itineraryPlaces ItineraryPlace[]
  itineraryRoutes ItineraryRoute[]
  routeMatrixCaches RouteMatrixCache[]
  memories      Memory[]
  travelPhotos  TravelPhoto[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeVisitStatuses PlaceVisitStatus[]
}

model ItineraryPlace {
  id          String   @id @default(uuid())
  tripId      String
  dayNumber   Int
  name        String
  category    String?
  latitude    Float
  longitude   Float
  visitTime   String?
  duration    String?
  orderIndex  Int
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ItineraryRoute {
  id            String   @id @default(uuid())
  tripId        String
  dayNumber     Int
  startPlaceId  String
  endPlaceId    String
  distance      Float
  duration      Int
  transportMode String
  geometry      String   @db.Text
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model RouteMatrixCache {
  id            String   @id @default(uuid())
  tripId        String
  dayNumber     Int
  locationsHash String   @unique
  matrixData    String   @db.Text
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ItineraryDay {
  id          String        @id @default(uuid())
  tripId      String
  dayNumber   Int
  title       String
  description String?
  createdAt   DateTime      @default(now())
  activities  Activity[]
  photos      TravelPhoto[]
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Activity {
  id             String       @id @default(uuid())
  itineraryDayId String
  name           String
  description    String?
  location       String?
  startTime      DateTime?
  endTime        DateTime?
  category       String?
  createdAt      DateTime     @default(now())
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
}

model TravelPhoto {
  id             String         @id @default(uuid())
  userId         String
  tripId         String
  itineraryDayId String?
  secureUrl      String?
  publicId       String?
  originalUrl    String
  thumbnailUrl   String?
  imageUrl       String?        // Legacy field — kept for backward compat with trip.service.ts
  caption        String?
  width          Int?
  height         Int?
  format         String?
  fileSize       Int?
  fileType       String?
  locationName   String?
  latitude       Float?
  longitude      Float?
  isFeatured     Boolean        @default(false)
  rewardStatus   String         @default("NONE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryDay   ItineraryDay?  @relation(fields: [itineraryDayId], references: [id], onDelete: SetNull)

  @@index([tripId, itineraryDayId])
  @@index([userId])
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  clerkUserId String    @unique
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  country     String?
  city        String?
  language    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  travelStyle             String?
  budgetRange             String?
  interests               String[]
  foodPreference          String[]
  accommodationPreference String?
  tripDuration            String?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id          String   @id @default(uuid())
  userId      String
  type        String
  referenceId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id @default(uuid())
  userId      String
  tripId      String?
  title       String
  description String?
  photos      String[]
  location    String?
  createdAt   DateTime @default(now())
  trip        Trip?    @relation(fields: [tripId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Float  @default(0.0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  type      String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String @id @default(uuid())
  referrerId     String
  referredUserId String @unique
  status         String
  reward         Float  @default(0.0)
  referredUser   User   @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer       User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
}

model UserLocation {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlaceVisitStatus {
  id        String   @id @default(uuid())
  tripId    String
  placeId   String
  status    String   // "completed" | "current" | "upcoming"
  updatedAt DateTime @updatedAt
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, placeId])
}

model MapPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  layers        String[]
  transportMode String   @default("walk")
  travelStyle   String   @default("adventure")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransportRoutes {
  id             String   @id @default(uuid())
  origin         String
  destination    String
  mode           String
  serviceNumber  String?
  operator       String
  duration       String
  price          Float
  runsOn         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TransportProviders {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Stations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model BusStops {
  id        String   @id @default(uuid())
  name      String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model RailwayStations {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model JourneyPlans {
  id                   String   @id @default(uuid())
  origin               String
  destination          String
  date                 String
  totalDurationMinutes Int
  totalCost            Float
  transfers            Int
  isDirect             Boolean
  bookingUrl           String
  aiExplanation        String?
  createdAt            DateTime @default(now())
}

model UserSearchHistory {
  id             String   @id @default(uuid())
  userId         String
  origin         String
  destination    String
  searchDate     String
  passengers     Int      @default(1)
  rankPreference String   @default("balanced")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PriceWatch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route     String
  targetPrice Float?
  currentPrice Float?
  createdAt DateTime @default(now())
}

// ─── CONTEXT INTELLIGENCE LAYER MODELS ─────────────────────────────────────────
// Phase 1 of the Contextual Intelligence Layer plan: persistent memory
// (preferences, favorites, feedback, notifications, recommendation log).
// Consumed by backend/src/context/memory.service.ts and recommendation.service.ts.

enum FeedbackAction {
  SAVED
  SKIPPED
  RATED
  BOOKED
  CANCELLED
  CLICKED
  IGNORED
}

enum NotificationKind {
  DELAY
  GATE_CHANGE
  WEATHER
  PRICE_DROP
  VISA
  PASSPORT
  COUNTDOWN
  BUDGET
  TRAFFIC
  GENERIC
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  currency             String?  @default("INR")
  language             String?  @default("en")
  homeCity             String?
  favoriteAirlines     String[]
  favoriteHotelChains  String[]
  favoriteCuisines     String[]
  dietaryRestrictions  String[]
  accessibilityNotes   String?
  preferredTransport   String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FavoriteHotel {
  id        String   @id @default(uuid())
  userId    String
  hotelId   String
  hotelName String
  city      String?
  rating    Float?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([userId])
}

model FavoriteActivity {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  name       String
  city       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  tripId    String?
  module    String         // "flights" | "hotels" | "trains" | "buses" | "budget" | ...
  targetId  String
  action    FeedbackAction
  rating    Int?
  metadata  Json?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@index([module, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  tripId    String?
  metadata  Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model RecommendationLog {
  id           String   @id @default(uuid())
  userId       String?
  module       String
  inputHash    String
  outputJson   Json
  aiConfidence Int
  accepted     Boolean?
  createdAt    DateTime @default(now())

  @@index([userId, module, createdAt])
  @@index([inputHash])
}
